# ---------------------------------------------------------------------------
# Tavus (tavus.io) — powers the "Talk to my AI Clone" page (/clone).
# Copy this file to `.env.local` and fill in the values once you've created
# a replica at https://platform.tavus.io.
# ---------------------------------------------------------------------------

# Your Tavus API key (Platform → API Keys). Keep this secret — server-side only.
TAVUS_API_KEY=

# The replica ID of your AI clone (Platform → Replicas).
TAVUS_REPLICA_ID=

# Optional: a Tavus Persona ID if you've configured one (controls the
# clone's conversational behavior/knowledge separately from the replica).
TAVUS_PERSONA_ID=
