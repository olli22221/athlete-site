# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
# Nothing here is required to run `next dev` — the site degrades to setup
# instructions wherever a key is missing.
# ---------------------------------------------------------------------------

# --- Signing secret --------------------------------------------------------
# Signs the visitor wallet cookie. Any random 32+ character string.
# Generate one with: openssl rand -base64 32
APP_SECRET=

# --- Tavus (tavus.io) — the video avatar -----------------------------------
# Your Tavus API key (Platform → API Keys). Server-side only, keep it secret.
TAVUS_API_KEY=

# The replica ID of your avatar (Platform → Replicas).
TAVUS_REPLICA_ID=

# Optional: a Persona ID, if you configured one to control what the avatar
# knows and how it behaves.
TAVUS_PERSONA_ID=

# --- Cost guards -----------------------------------------------------------
# Tavus bills per conversation minute, so these are the ceilings that keep a
# bad day from becoming an expensive one. Sessions are reserved at their
# maximum length, so these are worst-case budgets.
#
# Free tiers only (the 60-second teaser and the 5-minute email session):
AVATAR_FREE_MINUTES_PER_DAY=30
# Absolute ceiling across every tier, paid sessions included:
AVATAR_TOTAL_MINUTES_PER_DAY=180

# --- Upstash Redis — credits, rate limits, budget counters ------------------
# Without these the app falls back to an in-process map: fine for `next dev`,
# but it forgets everything on restart and cannot hold a limit across
# instances. Payments are refused entirely until this is set, because selling
# a credit into a store that loses it is worse than not selling it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stripe — credit packs -------------------------------------------------
# Secret key (Developers → API keys).
STRIPE_SECRET_KEY=

# Webhook signing secret for the `checkout.session.completed` event, pointed
# at /api/stripe/webhook (Developers → Webhooks).
# Locally: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Site ------------------------------------------------------------------
# Canonical origin, used for Stripe redirects, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
